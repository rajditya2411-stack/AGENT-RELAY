{
  "active_profile": "STRICT PRODUCTION",
  "enforcement_state": "ENFORCING",
  "version": "v2.4.1-local",
  "stats": {
    "blocks_24h": 42,
    "intercepts_pending": 0,
    "latency_ms": 1.2
  },
  "pathguard": {
    "certificates": true,
    "custom_globs": [
      "**/config/secrets.*",
      "~/.aws/credentials"
    ],
    "service_account": true,
    "env_files": true,
    "ssh_keys": true
  },
  "commandguard": {
    "rm_rf": true,
    "git_force_push": true,
    "sudo_su": true,
    "curl_pipe_bash": true
  },
  "secretredactor": {
    "masking_format": "tag",
    "providers": {
      "anthropic": true,
      "openai": true,
      "aws": true,
      "github": true
    }
  },
  "sandbox": {
    "runtime_engine": "docker",
    "cgroups_cpu_cores": 2,
    "cgroups_ram_limit": "4GB",
    "network_policy": "bridge_isolated",
    "mount_policy": "ro_root"
  }
}